# LLM Insight Studio — environment template
# Copy to .env (never commit real secrets).

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Persistence ---
DATABASE_URL=sqlite:///./artifacts/studio.db
ARTIFACTS_DIR=./artifacts

# --- Hugging Face ---
# Optional. Required for gated/private models.
HF_TOKEN=

# --- Default models ---
DEFAULT_CLASSIFICATION_MODEL=distilbert-base-uncased-finetuned-sst-2-english
DEFAULT_SUMMARIZATION_MODEL=google/flan-t5-base
DEFAULT_QA_MODEL=deepset/roberta-base-squad2
DEFAULT_INSTRUCT_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Inference provider: "mock" (no downloads) or "transformers" ---
INFERENCE_PROVIDER=mock

# --- Agent ---
AGENT_ENABLED=true
AGENT_MAX_REFERENCES=25
